VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<tu-clave-publicable>

# Opcional: fuerza la version de build. Si no se define, vite.config.mjs la
# deriva del HEAD de git. Se usa para el cache busting del service worker.
# VITE_BUILD_VERSION=<version>

# Las notificaciones web push ya no tienen cliente. La Edge Function
# send-push-notification y la tabla push_subscriptions siguen desplegadas y
# endurecidas por RLS, pero nada se suscribe: no hay codigo en src/ que use
# VITE_VAPID_PUBLIC_KEY. Si algun dia se recupera el push hay que rehacer la
# capa de cliente y volver a declarar aqui la clave publica.

VITE_APP_TITLE=Academia Cosmo Music
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<tu-clave-publicable>

# Notificaciones push (Web Push). Clave pública usada por el cliente para
# suscribirse; public/privada + subject configurados en la Edge Function
# send-push-notification (variables VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/
# VAPID_SUBJECT en el proyecto Supabase).
VITE_VAPID_PUBLIC_KEY=<tu-clave-vapid-publica>
